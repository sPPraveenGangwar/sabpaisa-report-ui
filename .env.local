# Backend API URL
REACT_APP_API_URL=http://localhost:8000/api/v1

# Optional features
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_EXPORTS=true

# Environment Identifier
REACT_APP_ENVIRONMENT=local
