# ===============================================
# STAGING ENVIRONMENT CONFIGURATION (Frontend)
# For staging server deployment
# ===============================================

# Backend API URL
REACT_APP_API_URL=https://stage-api.yourdomain.com/api/v1

# Optional features
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_EXPORTS=true

# Environment Identifier
REACT_APP_ENVIRONMENT=staging
